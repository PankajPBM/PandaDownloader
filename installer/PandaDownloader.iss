; Script generated by Antigravity IDE for PB Tech Zone
; Application: Panda Downloader
; Website: https://prakash77.com.np
; Support WhatsApp: +9779814891277

#define MyAppName "Panda Downloader"
#define MyAppVersion "1.0.0"
#define MyAppPublisher "PB Tech Zone"
#define MyAppURL "https://prakash77.com.np"
#define MyAppWhatsApp "https://wa.me/9779814891277"
#define MyAppExeName "PandaDownloader.exe"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
AppId={{B81F28F4-0D68-45F9-8A19-9B84DF9A65D4}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} v{#MyAppVersion} (PB Tech Zone)
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppWhatsApp}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\PB Tech Zone\Panda Downloader
DefaultGroupName={#MyAppPublisher}\{#MyAppName}
AllowNoIcons=yes
LicenseFile=..\LICENSE
OutputDir=Output
OutputBaseFilename=PandaDownloader_Setup_v1.0.0
SetupIconFile=..\assets\icon.ico
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
PrivilegesRequired=admin
ArchitecturesInstallIn64BitMode=x64compatible
UninstallDisplayIcon={app}\assets\icon.ico
VersionInfoVersion=1.0.0.0
VersionInfoCompany={#MyAppPublisher}
VersionInfoDescription=High-Speed Multi-Threaded Dynamic Segmentation Download Manager
VersionInfoCopyright=Copyright (C) 2026 PB Tech Zone

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: checkedonce
Name: "autostart"; Description: "Launch Panda Downloader background daemon on Windows startup"; GroupDescription: "System Integration:"; Flags: checkedonce

[Files]
; Main application binaries and electron runtime
Source: "..\release\PandaDownloader-win32-x64\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; Source and assets
Source: "..\assets\*"; DestDir: "{app}\assets"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "..\bin\*"; DestDir: "{app}\bin"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "..\extension\*"; DestDir: "{app}\extension"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\assets\icon.ico"
Name: "{group}\PB Tech Zone Website"; Filename: "{#MyAppURL}"
Name: "{group}\WhatsApp Support"; Filename: "{#MyAppWhatsApp}"
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\assets\icon.ico"; Tasks: desktopicon

[Registry]
; Windows Run on startup
Root: HKCU; Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; ValueType: string; ValueName: "PandaDownloader"; ValueData: """{app}\{#MyAppExeName}"" --background"; Flags: uninsdeletevalue; Tasks: autostart

; Custom URL Protocol: pandadl://
Root: HKA; Subkey: "Software\Classes\pandadl"; ValueType: string; ValueName: ""; ValueData: "URL:Panda Downloader Protocol"; Flags: uninsdeletekey
Root: HKA; Subkey: "Software\Classes\pandadl"; ValueType: string; ValueName: "URL Protocol"; ValueData: ""
Root: HKA; Subkey: "Software\Classes\pandadl\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\assets\icon.ico,0"
Root: HKA; Subkey: "Software\Classes\pandadl\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""

; Chrome & Edge Native Messaging Host Registration
Root: HKLM; Subkey: "Software\Google\Chrome\NativeMessagingHosts\com.panda.downloader"; ValueType: string; ValueName: ""; ValueData: "{app}\extension\native-messaging\com.panda.downloader.json"; Flags: uninsdeletekey
Root: HKLM; Subkey: "Software\Microsoft\Edge\NativeMessagingHosts\com.panda.downloader"; ValueType: string; ValueName: ""; ValueData: "{app}\extension\native-messaging\com.panda.downloader.json"; Flags: uninsdeletekey

[Run]
; Add Windows Firewall Exception for Local Daemon Port 45731
Filename: "netsh"; Parameters: "advfirewall firewall add rule name=""Panda Downloader Loopback Daemon"" dir=in action=allow protocol=TCP localport=45731"; Flags: runhidden; StatusMsg: "Configuring local loopback firewall permissions..."

; Launch program after install
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[UninstallRun]
; Remove Windows Firewall rule on uninstall
Filename: "netsh"; Parameters: "advfirewall firewall delete rule name=""Panda Downloader Loopback Daemon"""; Flags: runhidden

[Code]
procedure InitializeWizard;
var
  InfoLabel: TLabel;
begin
  WizardForm.WelcomeLabel2.Caption := 
    'Welcome to Panda Downloader Setup!' + #13#10#13#10 +
    'Developed & Published by PB Tech Zone' + #13#10 +
    'Official Website: ' + '{#MyAppURL}' + #13#10 +
    'Support WhatsApp: +977 9814891277' + #13#10#13#10 +
    'This will install Panda Downloader high-speed acceleration engine on your computer.';
end;
